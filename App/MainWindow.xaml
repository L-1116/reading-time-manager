<Window x:Class="ReadingTimeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading Time Manager 0.1.2" Icon="Assets/ReadingTimeManager.ico" Width="1240" Height="830" MinWidth="880" MinHeight="610"
        WindowStartupLocation="CenterScreen" Background="#F5F5F1" Foreground="#202321" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True"
        PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202321" />
            <Setter Property="BorderBrush" Value="#D7DAD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#337B75" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#337B75" /><Setter TargetName="Outline" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outline" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outline" Property="Opacity" Value="0.40" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="BookRow">
            <Grid Margin="3,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="34" Height="42" Background="#EBEDE7" CornerRadius="4" Margin="0,0,11,0">
                    <Path Data="M2,2 L12,2 12,15 2,15 Z M5,2 L5,15 M7,6 L10,6 M7,9 L10,9" Stroke="#59645B" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DaysText}" FontSize="12" Foreground="#575E56" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="Shell" Background="#F5F5F1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="219" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#FBFBF8" BorderBrush="#DDE0D9" BorderThickness="0,0,1,0" Padding="20,26,20,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="Assets/Mark.png" Width="45" Height="45" HorizontalAlignment="Left" />
                    <TextBlock Text="阅读记录" FontSize="24" FontWeight="Bold" Margin="0,9,0,3" />
                    <TextBlock Text="Reading Time Manager" Foreground="#575E56" FontSize="12" />
                    <Border Height="1" Background="#E0E1DC" Margin="0,23,0,19" />
                    <TextBlock Text="浏览记录" FontSize="12" Foreground="#575E56" Margin="2,0,0,9" />
                    <Button x:Name="DailyNav" Content="01   每日时长" Style="{StaticResource Nav}" Click="NavigateDaily" />
                    <Button x:Name="BooksNav" Content="02   阅读书籍" Style="{StaticResource Nav}" Click="NavigateBooks" />
                    <Button x:Name="TotalNav" Content="03   累计时长" Style="{StaticResource Nav}" Click="NavigateTotal" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="●  本地 · 只读" Foreground="#2E6A63" FontWeight="SemiBold" />
                    <TextBlock Text="WINDOWS  /  0.1.2" Foreground="#575E56" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Background="#FBFBF8" BorderBrush="#DDE0D9" BorderThickness="0,0,0,1" Padding="27,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="SourceName" Text="未导入数据" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SourceInfo" Text="可拖入一个 TSV 文件" FontSize="12" Foreground="#575E56" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="ReloadButton" Content="重新读取" Click="ReloadHistory" IsEnabled="False" Margin="0,0,8,0" />
                        <Button x:Name="OpenButton" Content="打开 TSV…" Click="PickFile" Background="#222623" Foreground="White" BorderBrush="#222623" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="Notice" Grid.Row="1" Background="#FEF3E6" BorderBrush="#E7CFB2" BorderThickness="1" CornerRadius="8" Margin="26,14,26,0" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" Foreground="#674D33" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Page" Margin="26,22,26,26" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
